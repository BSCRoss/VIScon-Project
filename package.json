{
  "name": "greygiraffe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "bootstrap": "bash scripts/setup.sh",
    "import:menus": "tsx --env-file=.env scripts/import.ts",
    "e2e": "node scripts/e2e.mjs",
    "demo:reset": "tsx --env-file=.env scripts/demo-reset.ts && prisma db seed",
    "popularity": "tsx --env-file=.env scripts/popularity.ts",
    "images:cache": "tsx --env-file=.env scripts/images.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@prisma/client": "6",
    "@qdrant/js-client-rest": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.55.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "prisma": "6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
