// greyGiraffe data model. Spec: plans/2-architecture.md §4
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Campus {
  ETH_ZENTRUM
  ETH_HOENGGERBERG
  ETH_OERLIKON
  ETH_BASEL
  UZH_ZENTRUM
  UZH_IRCHEL
  UZH_OERLIKON
  OTHER
}

/// Where a user is on a given weekday. ZENTRUM = ETH main building (HG) + UZH Zentrum.
enum Area {
  ZENTRUM
  HOENGGERBERG
}

enum MenuSource {
  ETH_COOKPIT
  FOOD2050
  SEED
}

enum MealTime {
  LUNCH
  DINNER
}

enum GroupRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// none / <10 / 10–30 / >30 people in the queue
enum QueueBucket {
  NONE
  LT10
  B10_30
  GT30
}

model User {
  id           String   @id @default(cuid())
  /// lowercase, 3–24 chars, [a-z0-9_]
  username     String   @unique
  passwordHash String
  displayName  String?
  /// soft filter preferences, not hard rules
  vegetarian   Boolean  @default(false)
  vegan        Boolean  @default(false)
  createdAt    DateTime @default(now())

  mensas      UserMensa[]
  allergens   UserAllergen[]
  weekdays    UserWeekday[]
  decisions   GroupDecision[] @relation("DecisionCommitter")
  votes       GroupVote[]
  memberships GroupMember[]
  groupsOwned Group[]        @relation("GroupOwner")
  invitesSent GroupInvite[]  @relation("InviteFrom")
  invitesGot  GroupInvite[]  @relation("InviteTo")
  swipes      Swipe[]
  plans       Plan[]
  feedback    Feedback[]
}

model Mensa {
  id           String     @id @default(cuid())
  name         String
  campus       Campus
  source       MenuSource
  /// ETH: facility-id as string ("9"). food2050: "uzh-zentrum/untere-mensa/mittag"
  sourceId     String
  offersLunch  Boolean    @default(true)
  offersDinner Boolean    @default(false)
  infoUrl      String?
  /// hide closed/unused mensas from pickers
  isActive     Boolean    @default(true)

  dishes    Dish[]
  users     UserMensa[]
  plans     Plan[]
  feedback  Feedback[]
  decisions GroupDecision[]
  votes     GroupVote[]

  @@unique([source, sourceId])
}

model Dish {
  id            String   @id @default(cuid())
  mensaId       String
  mensa         Mensa    @relation(fields: [mensaId], references: [id], onDelete: Cascade)
  /// calendar date in Europe/Zurich, stored as UTC midnight
  date          DateTime @db.Date
  mealTime      MealTime
  /// stable per source, see plans/3-menu-import.md; drives upsert
  sourceKey     String
  /// ETH "line" (counter) name, e.g. "Rice Up! Bowl"
  lineName      String?
  name          String
  description   String?
  /// "Meat" | "Vegetarian" | "Vegan" | "Fish" | null
  mealClass     String?
  isVegetarian  Boolean?
  isVegan       Boolean?
  priceStudent  Decimal? @db.Decimal(6, 2)
  priceInternal Decimal? @db.Decimal(6, 2)
  priceExternal Decimal? @db.Decimal(6, 2)
  imageUrl      String?
  calories      Int?
  protein       Float?
  fat           Float?
  carbs         Float?
  sugar         Float?
  salt          Float?
  importedAt    DateTime @default(now())
  /// popularity prediction from similar past dishes, -1..1 (see lib/popularity); null = not predicted yet
  predictedScore Float?
  /// how many similar dishes with real votes backed the prediction
  predictedN     Int?
  predictedAt    DateTime?

  embedding DishEmbedding?
  image     DishImage?
  allergens DishAllergen[]
  swipes    Swipe[]
  feedback  Feedback[]

  @@unique([mensaId, sourceKey])
  @@index([date, mensaId])
}

/// resized copies of the dish photo (lib/images.ts), served by /api/img/[dishId]. Originals are 300–650 KB.
model DishImage {
  dishId    String   @id
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  /// 192px-wide WebP for list thumbnails
  thumb     Bytes
  /// 720px-wide WebP for cards and the feedback popup
  medium    Bytes
  width     Int
  height    Int
  updatedAt DateTime @updatedAt
}

/// cached sentence embedding of "name + description" (lib/popularity/embed.ts)
model DishEmbedding {
  dishId    String   @id
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  model     String
  text      String
  vector    Float[]
  updatedAt DateTime @updatedAt
}

/// fixed 14 rows, EU allergen codes; seeded
model Allergen {
  id     Int    @id
  nameEn String
  nameDe String

  dishes DishAllergen[]
  users  UserAllergen[]
}

model DishAllergen {
  dishId     String
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  allergenId Int
  allergen   Allergen @relation(fields: [allergenId], references: [id])

  @@id([dishId, allergenId])
}

model UserAllergen {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allergenId Int
  allergen   Allergen @relation(fields: [allergenId], references: [id])

  @@id([userId, allergenId])
}

/// Which campus area the user is on each weekday (1 = Monday … 5 = Friday). Missing = not on campus.
model UserWeekday {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekday Int
  area    Area

  @@id([userId, weekday])
}

model UserMensa {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mensaId String
  mensa   Mensa  @relation(fields: [mensaId], references: [id], onDelete: Cascade)

  @@id([userId, mensaId])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("GroupOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members   GroupMember[]
  invites   GroupInvite[]
  plans     Plan[]
  decisions GroupDecision[]
  votes     GroupVote[]
}

/// One member's vote for "mensa + start time" on a day. The vote resolves itself (lib/votes.ts):
/// majority → decision; else 45 min before the earliest proposed time → plurality wins.
model GroupVote {
  id          String   @id @default(cuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mensaId     String
  mensa       Mensa    @relation(fields: [mensaId], references: [id])
  slotMinutes Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([groupId, date, userId])
}

/// The committed outcome for a group on a day: "we eat at <mensa> at <slot>". One per group per day.
model GroupDecision {
  id            String   @id @default(cuid())
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  mensaId       String
  mensa         Mensa    @relation(fields: [mensaId], references: [id])
  /// minutes after midnight, 660..840 step 15
  slotMinutes   Int
  committedById String
  committedBy   User     @relation("DecisionCommitter", fields: [committedById], references: [id])
  /// MANUAL | VOTE_MAJORITY | VOTE_DEADLINE | VOTE_ENDED
  method        String   @default("MANUAL")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([groupId, date])
}

model GroupMember {
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
}

model GroupInvite {
  id         String       @id @default(cuid())
  groupId    String
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUserId String
  from       User         @relation("InviteFrom", fields: [fromUserId], references: [id])
  toUserId   String
  to         User         @relation("InviteTo", fields: [toUserId], references: [id])
  status     InviteStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@unique([groupId, toUserId])
}

/// one reaction per user per dish; the dish already carries the date
model Swipe {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dishId    String
  dish      Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  /// -2 | -1 | 1 | 2  (right = "I want to eat this today")
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dishId])
}

/// the user's availability + group for one day: one lunch per day
model Plan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// selected start slots (minutes after midnight, 660..840 step 15); several windows allowed, e.g. 11:00–12:00 and 13:00–14:00
  slots       Int[]    @default([])
  mensaId     String?
  mensa       Mensa?   @relation(fields: [mensaId], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
}

/// post-meal data; one per user per day
model Feedback {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  mensaId     String
  mensa       Mensa       @relation(fields: [mensaId], references: [id])
  dishId      String?
  dish        Dish?       @relation(fields: [dishId], references: [id], onDelete: SetNull)
  /// optional: the quick "yesterday" popup only asks for rating + would-again
  queueBucket QueueBucket?
  waitMinutes Int?
  /// 1..5
  rating      Int
  wouldAgain  Boolean?
  comment     String?
  /// minutes after midnight, when they actually arrived
  arrivedAt   Int?
  createdAt   DateTime    @default(now())

  @@unique([userId, date])
}
