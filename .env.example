# Copy to .env.local (Next.js) – Prisma CLI also reads .env, so for local dev you can simply name it .env
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/greygiraffe"   # Neon: pooled URL
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/greygiraffe"     # Neon: direct (unpooled) URL, used for migrations
AUTH_SECRET="change-me-run-npx-auth-secret"
AUTH_TRUST_HOST=true
CRON_SECRET="change-me-random-string"
IMPORT_USER_AGENT="greyGiraffe/0.1 (hackathon; contact: you@example.com)"
