# Copy to .env.local (Next.js) – Prisma CLI also reads .env, so for local dev you can simply name it .env
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/greygiraffe"   # Neon: pooled URL
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/greygiraffe"     # Neon: direct (unpooled) URL, used for migrations
AUTH_SECRET="change-me-run-npx-auth-secret"
AUTH_TRUST_HOST=true
CRON_SECRET="change-me-random-string"
IMPORT_USER_AGENT="greyGiraffe/0.1 (hackathon; contact: you@example.com)"

# Optional: pin the app's calendar date for demos (YYYY-MM-DD). Menus, swipes and plans all use this date.
# DEMO_DATE=2026-10-09

# Popularity prediction (lib/popularity): vector store. Start with `docker compose up -d`; without it an in-memory fallback is used.
QDRANT_URL="http://127.0.0.1:6333"
# QDRANT_API_KEY=   # only for Qdrant Cloud
# Set to false on Vercel (the embedding model does not run in serverless); run `pnpm popularity` from a machine instead.
POPULARITY_ON_IMPORT=true
